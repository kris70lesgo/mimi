VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Mimi Coach — server-only. Set this in Vercel, never prefix it with NEXT_PUBLIC
# or VITE and never commit a real key.
MIMI_AI_API_KEY=your_deepseek_or_openai_compatible_key
# Optional: these defaults target DeepSeek's OpenAI-compatible API.
MIMI_AI_BASE_URL=https://api.deepseek.com/v1
MIMI_AI_MODEL=deepseek-chat

# Configure these only as Supabase Edge Function secrets; never expose them to Vite/browser code.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
