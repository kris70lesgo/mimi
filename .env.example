VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Mimi Coach — server-only. Set exactly one provider in Vercel; never prefix a
# key with NEXT_PUBLIC or VITE and never commit a real key.
# Supported values: deepseek (default), grok (or xai), gemini (or google), custom.
MIMI_AI_PROVIDER=deepseek

# DeepSeek (default)
MIMI_AI_API_KEY=your_deepseek_api_key
# MIMI_AI_BASE_URL=https://api.deepseek.com/v1
# MIMI_AI_MODEL=deepseek-chat

# Grok / xAI
# MIMI_AI_PROVIDER=grok
# XAI_API_KEY=your_xai_api_key
# MIMI_AI_BASE_URL=https://api.x.ai/v1
# MIMI_AI_MODEL=grok-4.6

# Google Gemini, through Google's OpenAI-compatible endpoint
# MIMI_AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key
# MIMI_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MIMI_AI_MODEL=gemini-3.8-flash

# For any other OpenAI-compatible service, use custom plus these three values.
# MIMI_AI_PROVIDER=custom
# MIMI_AI_API_KEY=your_provider_api_key
# MIMI_AI_BASE_URL=https://your-provider.example/v1
# MIMI_AI_MODEL=your-model-id

# Configure these only as Supabase Edge Function secrets; never expose them to Vite/browser code.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
